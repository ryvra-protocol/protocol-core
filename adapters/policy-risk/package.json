{
  "name": "@ryvra/policy-risk-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.0",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ryvra/contracts": "workspace:*"
  },
  "scripts": {
    "build": "pnpm --filter @ryvra/contracts run build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @ryvra/contracts run build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && node --test dist/test/*.spec.js"
  }
}
