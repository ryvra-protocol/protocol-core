{
  "name": "ryvra-protocol-core",
  "private": true,
  "version": "0.1.0",
  "description": "Ryvra Protocol Core: docs-and-interfaces-first baseline.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "lint": "markdownlint-cli2 \"README.md\" \"CONTRIBUTING.md\" \"SECURITY.md\" \"docs/**/*.md\"",
    "format": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck",
    "typecheck": "if find apps packages -type f \\( -name '*.ts' -o -name '*.tsx' \\) | grep -q .; then tsc --noEmit -p tsconfig.base.json; else echo \"No TypeScript sources yet (placeholder).\"; fi"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
